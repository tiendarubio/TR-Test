rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIs(roles) { return signedIn() && request.auth.token.role in roles; }
    function canWriteFinance() { return roleIs(['admin','contabilidad']); }

    match /movements/{id} {
      allow read: if roleIs(['admin','contabilidad','consulta']);
      // Las escrituras pasan por /api/movements para forzar validación + auditoría.
      allow create, update, delete: if false;
    }

    match /categories/{id} {
      allow read: if roleIs(['admin','contabilidad','consulta']);
      allow write: if roleIs(['admin']);
    }

    match /budgets/{id} {
      allow read: if roleIs(['admin','contabilidad','consulta']);
      allow write: if roleIs(['admin','contabilidad']);
    }

    match /activity_log/{id} {
      allow read: if roleIs(['admin','contabilidad']);
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || roleIs(['admin']));
      allow write: if false;
    }
  }
}
