# Firebase cliente (Vercel -> Environment Variables)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Acceso. Separar múltiples correos con coma.
ROLE_ADMIN_EMAILS=
ROLE_ACCOUNTING_EMAILS=
ROLE_VIEWER_EMAILS=

# Proveedores (misma fuente de Google Sheets utilizada por TR-Recepcion)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_PROV_RANGE=proveedores!C2:C1000
